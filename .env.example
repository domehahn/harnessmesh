# Local development defaults. Copy to .env and replace all tokens.
HARNESSMESH_MCP_TOKEN=hm_mcp_replace_with_a_long_random_token
HARNESSMESH_BRIDGE_TOKEN=hm_bridge_replace_with_a_long_random_token
HARNESSMESH_PROVIDER_TOKEN=hm_provider_replace_with_a_long_random_token
HARNESSMESH_ADMIN_TOKEN=hm_admin_replace_with_a_long_random_token
HARNESSMESH_SECRET_BACKEND=local
# Required for local encrypted tenant-secret storage (32+ random characters).
HARNESSMESH_SECRET_KEY=replace_with_a_long_random_secret_key
# For Vault mode use: make vault-up, then set backend=vault and token below.
VAULT_TOKEN=dev-root-token
HARNESSMESH_VAULT_MOUNT=secret
HARNESSMESH_DASHBOARD_OAUTH_INTROSPECTION_URL=http://harnessmesh-keycloak:8080/realms/harnessmesh/protocol/openid-connect/token/introspect
HARNESSMESH_DASHBOARD_OAUTH_CLIENT_ID=harnessmesh-dashboard
# Public PKCE client: leave empty. Use a separate confidential introspection
# client in production if the provider requires authenticated introspection.
HARNESSMESH_DASHBOARD_OAUTH_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_local_keycloak_admin_password

# PostgreSQL production profile.
HARNESSMESH_POSTGRES_DB=harnessmesh
HARNESSMESH_POSTGRES_USER=harnessmesh
HARNESSMESH_POSTGRES_PASSWORD=replace_with_a_long_random_database_password
# Set this to activate the PostgreSQL store in MCP; leave empty for SQLite.
HARNESSMESH_POSTGRES_DSN=

# External agent plugins. The default directory is ./plugins. In production,
# require a matching binary digest and optionally Ed25519 signatures.
HARNESSMESH_PLUGIN_DIR=plugins
HARNESSMESH_PLUGIN_REQUIRE_HASH=0
HARNESSMESH_PLUGIN_REQUIRE_SIGNATURE=0
HARNESSMESH_PLUGIN_TRUSTED_KEYS=
HARNESSMESH_MARKETPLACE_SOURCE_ROOT=plugins
HARNESSMESH_MARKETPLACE_ARTIFACT_ENDPOINT=http://127.0.0.1:9000
HARNESSMESH_MARKETPLACE_CDN_BASE_URL=
HARNESSMESH_MARKETPLACE_BUCKET=harnessmesh-marketplace
HARNESSMESH_MARKETPLACE_REGION=us-east-1
HARNESSMESH_OBJECTSTORE_ACCESS_KEY=harnessmesh
HARNESSMESH_OBJECTSTORE_SECRET_KEY=replace_with_a_local_objectstore_secret
HARNESSMESH_MARKETPLACE_REQUIRE_SCANS=0
HARNESSMESH_MARKETPLACE_SYFT_BIN=
HARNESSMESH_MARKETPLACE_GRYPE_BIN=
HARNESSMESH_MARKETPLACE_TRIVY_BIN=
HARNESSMESH_MARKETPLACE_CLAMAV_BIN=
HARNESSMESH_MARKETPLACE_SKIL_BIN=
HARNESSMESH_MARKETPLACE_REQUIRE_INDEX_SIGNATURE=0
HARNESSMESH_MARKETPLACE_SIGNING_KEY_ID=
# Base64 Ed25519 private key; inject from Vault/KMS at runtime, never commit it.
HARNESSMESH_MARKETPLACE_SIGNING_PRIVATE_KEY=
HARNESSMESH_MARKETPLACE_MAX_ACTIVE_PER_TENANT=0
# Runtime data-boundary gate for Ask/Review/Converse and agent messages.
HARNESSMESH_RUNTIME_SECURITY=1
HARNESSMESH_POLICY_FILE=
HARNESSMESH_ASSURANCE_SIGNING_KEY_ID=
# Base64 Ed25519 key from Vault/KMS; required when signed evidence is enforced.
HARNESSMESH_ASSURANCE_SIGNING_PRIVATE_KEY=
HARNESSMESH_REQUIRE_SIGNED_EVIDENCE=0
HARNESSMESH_SECURITY_QUARANTINE_THRESHOLD=3
HARNESSMESH_SECURITY_QUARANTINE_DURATION=15m
HARNESSMESH_OPA_BIN=
HARNESSMESH_OPA_PACKAGE=data.harnessmesh.allow
HARNESSMESH_MCP_TOOL_LOCK=

# Optional OTLP/HTTP export for redacted tenant-scoped logs and traces.
# Set the collector base URL, or configure the logs/traces URLs separately.
HARNESSMESH_OTEL_EXPORT_URL=
HARNESSMESH_OTEL_LOGS_URL=
HARNESSMESH_OTEL_TRACES_URL=
HARNESSMESH_OTEL_EXPORT_TOKEN=

# Optional browser OIDC/PKCE login for the React console.
VITE_OIDC_AUTHORITY=http://127.0.0.1:8080/realms/harnessmesh
VITE_OIDC_CLIENT_ID=harnessmesh-dashboard
VITE_OIDC_SCOPE=openid profile email
