{
  "schema_version": 1,

  "workflow": {
    "executor": "claude-executor",
    "reviewer": "codex-reviewer",
    "max_rounds": 3,
    "max_wall_time_minutes": 120,
    "stop_on_repeat": true,
    "test_command": ["go", "test", "./..."]
  },

  "context": {
    "max_diff_chars": 120000,
    "max_test_output_chars": 30000,
    "diff_context_lines": 30,
    "include_untracked": true
  },

  "switchyard": {
    "enabled": true,
    "base_url": "http://127.0.0.1:4000",
    "route_id": "switchyard",
    "inject_placeholder_auth": false,
    "extra_env": {}
  },

  "agents": {
    "claude-executor": {
      "kind": "claude",
      "command": "claude",
      "mode": "acceptEdits",
      "max_turns": 50,
      "timeout_minutes": 45,
      "extra_args": [],
      "env": {},
      "use_switchyard": true,
      "switchyard_route_id": "switchyard"
    },

    "codex-reviewer": {
      "kind": "codex",
      "command": "codex",
      "mode": "read-only",
      "max_turns": 50,
      "timeout_minutes": 45,
      "extra_args": [],
      "env": {},
      "use_switchyard": true,
      "switchyard_route_id": "switchyard"
    }
  }
}
