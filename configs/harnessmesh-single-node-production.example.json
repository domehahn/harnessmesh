{
  "version": 2,
  "workspace": {
    "single_writer": true
  },
  "security": {
    "require_agent_sandbox": true,
    "require_agent_network_isolation": true
  },
  "collaboration": {
    "max_peer_rounds": 3,
    "max_peer_depth": 2,
    "max_peer_calls": 10,
    "max_parallel_peers": 2,
    "peer_selection_policy": "least_busy",
    "session_timeout": "60m",
    "max_idle_duration": "15m",
    "strict_token_ceiling": true,
    "max_input_tokens": 100000,
    "max_output_tokens": 20000,
    "max_total_tokens": 120000,
    "circuit_breaker_failures": 3,
    "circuit_breaker_cooldown": "2m"
  },
  "workflow": {
    "executor": "claude-executor",
    "reviewer": "codex-reviewer",
    "max_rounds": 3,
    "max_wall_time_minutes": 120,
    "stop_on_repeat": true,
    "test_command": []
  },
  "context": {
    "max_context_chars": 100000,
    "max_diff_chars": 50000,
    "max_test_output_chars": 20000,
    "max_file_chars": 20000,
    "max_files": 20,
    "diff_context_lines": 30,
    "include_untracked": true,
    "denied_paths": [
      ".env",
      ".env.*",
      ".git/**",
      ".harnessmesh/**",
      "secrets/**",
      "credentials/**",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "terraform.tfstate",
      "*.tfstate",
      "*.tfstate.backup",
      "id_rsa",
      "id_rsa.*",
      "id_ed25519",
      "id_ed25519.*"
    ]
  },
  "change_control": {
    "enabled": true,
    "default_proofs": [
      "unit-tests",
      "build",
      "lint",
      "independent-review"
    ],
    "auto_commit": false
  },
  "bridge": {
    "enabled": true,
    "listen": "127.0.0.1:8788",
    "websocket_enabled": true,
    "allowed_origins": []
  },
  "provider": {
    "enabled": false,
    "listen": "127.0.0.1:8789",
    "zero_api_billing_mode": true,
    "denied_backend_types": ["openai-api", "codex"]
  },
  "agents": {
    "claude-executor": {
      "execution_mode": "managed",
      "adapter": "claude-code",
      "role": "executor",
      "roles": ["executor"],
      "writable": true,
      "command": "claude",
      "mode": "acceptEdits",
      "max_turns": 50,
      "timeout_minutes": 45,
      "allowed_commands": ["claude"],
      "allowed_paths": ["/workspace"],
      "network_mode": "none",
      "denied_paths": ["/workspace/.git", "/workspace/.harnessmesh"]
    },
    "codex-reviewer": {
      "execution_mode": "managed",
      "adapter": "codex",
      "role": "reviewer",
      "roles": ["reviewer", "correctness_review"],
      "writable": false,
      "command": "codex",
      "mode": "read-only",
      "max_turns": 50,
      "timeout_minutes": 45,
      "allowed_commands": ["codex"],
      "allowed_paths": ["/workspace"],
      "network_mode": "none",
      "denied_paths": ["/workspace/.git", "/workspace/.harnessmesh"]
    }
  },
  "capability_routing": {
    "review": ["codex-reviewer"],
    "correctness_review": ["codex-reviewer"]
  }
}
