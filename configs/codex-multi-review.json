{
  "version": 2,
  "workspace": {
    "single_writer": true
  },
  "collaboration": {
    "max_peer_rounds": 3,
    "max_peer_depth": 2,
    "max_peer_calls": 10,
    "max_parallel_peers": 3,
    "peer_selection_policy": "least_busy",
    "session_timeout": "60m",
    "max_idle_duration": "15m"
  },
  "workflow": {
    "executor": "codex-executor",
    "reviewer": "antigravity-reviewer",
    "max_rounds": 3,
    "max_wall_time_minutes": 120,
    "stop_on_repeat": true,
    "test_command": []
  },
  "context": {
    "max_context_chars": 100000,
    "max_diff_chars": 60000,
    "max_test_output_chars": 30000,
    "max_file_chars": 20000,
    "max_files": 25,
    "diff_context_lines": 30,
    "include_untracked": true
  },
  "agents": {
    "codex-executor": {
      "adapter": "codex",
      "role": "executor",
      "roles": ["executor"],
      "writable": true,
      "command": "codex",
      "timeout_minutes": 45
    },
    "antigravity-reviewer": {
      "adapter": "antigravity",
      "role": "reviewer",
      "roles": ["reviewer", "security_review"],
      "writable": false,
      "command": "agy",
      "timeout_minutes": 45
    },
    "claude-reviewer": {
      "adapter": "claude-code",
      "role": "reviewer",
      "roles": ["reviewer", "architecture_review"],
      "writable": false,
      "command": "claude",
      "mode": "acceptEdits",
      "timeout_minutes": 45
    }
  },
  "capability_routing": {
    "security_review": ["antigravity-reviewer"],
    "architecture_review": ["claude-reviewer"],
    "review": ["antigravity-reviewer", "claude-reviewer"]
  }
}

