{
  "version": 2,

  "collaboration": {
    "max_peer_rounds": 3,
    "max_peer_depth": 2,
    "max_peer_calls": 10,
    "session_timeout": "60m",
    "max_idle_duration": "15m"
  },

  "workflow": {
    "executor": "claude-executor",
    "reviewer": "codex-reviewer",
    "max_rounds": 3,
    "max_wall_time_minutes": 120,
    "stop_on_repeat": true,
    "test_command": []
  },

  "context": {
    "max_context_chars": 100000,
    "max_diff_chars": 50000,
    "max_test_output_chars": 20000,
    "max_file_chars": 20000,
    "max_files": 20,
    "diff_context_lines": 30,
    "include_untracked": true,
    "allowed_paths": [],
    "denied_paths": []
  },

  "switchyard": {
    "enabled": false,
    "base_url": "http://127.0.0.1:4000",
    "route_id": "switchyard",
    "inject_placeholder_auth": false,
    "extra_env": {}
  },

  "agents": {
    "claude-executor": {
      "adapter": "claude-code",
      "role": "executor",
      "writable": true,
      "command": "claude",
      "model": "",
      "mode": "acceptEdits",
      "max_turns": 50,
      "max_budget_usd": 0,
      "timeout_minutes": 45,
      "extra_args": [],
      "env": {},
      "use_switchyard": false
    },

    "codex-reviewer": {
      "adapter": "codex",
      "role": "reviewer",
      "writable": false,
      "command": "codex",
      "model": "",
      "mode": "read-only",
      "max_turns": 50,
      "timeout_minutes": 45,
      "extra_args": [],
      "env": {},
      "use_switchyard": false
    }
  }
}
